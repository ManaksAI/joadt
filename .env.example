# JoadT control-plane configuration.

# GitHub App — the no-master hub. Installing the app on a repo = plugging it into a tentacle.
# See docs/SETUP-APP.md. Until these are set, JoadT runs in local mode (roster from tentacles/).
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# The agent model for the SDLC engine (build agents). Analysis phases use a cheaper model.
ANTHROPIC_API_KEY=

# Control-plane server port (default 8790).
PORT=8790
